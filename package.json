{
  "name": "pantry-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "食材櫃 — offline-first Traditional Chinese pantry tracker PWA with optional household sync",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-runtime.mjs",
    "prebuild": "node scripts/copy-ocr-runtime.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "node scripts/copy-ocr-runtime.mjs && BASE_PATH=/pantry-tracker/ vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "icons": "python3 scripts/make-icons.py",
    "ocr:smoke": "node scripts/ocr-smoke.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
