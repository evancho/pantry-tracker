# Copy to .env.local for `npm run dev`. Do not commit real values.
# GitHub Pages bakes these in at build time from Actions secrets of the same names.
# Leave VITE_GOOGLE_CLIENT_ID empty to keep the site local-only (IndexedDB). The build still succeeds.
# VITE_GOOGLE_API_KEY is optional. The current Drive REST flow only needs the OAuth client id.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# Public add-friend link for the LINE official account 「生活提醒」. Optional.
# Do not put a Channel access token or channel secret in any VITE_ variable.
# VITE_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@example
